# Copy to infra/.env and fill in.
GEMINI_API_KEY=
# gemini-2.5-flash-lite (15 RPM free tier) is best for multi-agent demos.
# gemini-2.5-flash (5 RPM free tier) is higher quality but rate-limits fast.
GEMINI_MODEL=gemini-2.5-flash-lite
# Featherless powers the scheduled patient-reminder workflow.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# Speechmatics transcribes the doctor-patient consultation audio.
SPEECHMATICS_API_KEY=
ADMIN_PASSWORD=puskesmas2026
RECEPTIONIST_TOKEN=demo-receptionist-token
PUBLIC_BASE_URL=http://localhost:3000
PUSKESMAS_NAME=Puskesmas Kuripan, Banjarmasin
CORS_ORIGINS=http://localhost:3000,http://localhost
PUBLIC_API_URL=
# Optional: set DOMAIN for Caddy auto-TLS when deploying.
# DOMAIN=antricare.example.com
