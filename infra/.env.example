# Copy to infra/.env and fill in.

# One key drives every agent: Intake, Triage, Summarizer, Notes, Rx, Reminders.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Fast + cheap; used for conversational intake and the triage classifier.
OPENAI_MODEL=gpt-4o-mini
# Higher quality; used for the pre-visit summary and prescription drafting.
OPENAI_MODEL_CLINICAL=gpt-4o

# Optional: Speechmatics transcribes the doctor-patient consultation audio.
# Leave blank to disable the transcript feature.
SPEECHMATICS_API_KEY=

ADMIN_PASSWORD=clinic2026
RECEPTIONIST_TOKEN=demo-receptionist-token
PUBLIC_BASE_URL=http://localhost:3000
CLINIC_NAME=Patiently Demo Clinic
CORS_ORIGINS=http://localhost:3000,http://localhost
PUBLIC_API_URL=
# Optional: set DOMAIN for Caddy auto-TLS when deploying.
# DOMAIN=patiently.example.com
