# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://patiently:patiently@db:5432/patiently
SYNC_DATABASE_URL=postgresql://patiently:patiently@db:5432/patiently

# --- Models ---------------------------------------------------------------
# One key drives every agent: Intake, Triage, Summarizer, Notes, Rx, Reminders,
# and the mock consultation audio.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Conversational intake — fluency matters more than reasoning depth.
OPENAI_MODEL=gpt-4.1
# Chart writing, SOAP notes, prescription drafting — the reasoning-heavy work.
OPENAI_MODEL_CLINICAL=gpt-4.1
# The red-flag classifier is pinned to a model that still honours temperature=0.
# Reasoning models force temperature to 1, and a triage decision that cannot be
# reproduced cannot be audited.
OPENAI_MODEL_TRIAGE=gpt-4.1-mini
# Mock doctor-patient audio for the transcript demo.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: consultation transcripts with speaker diarization.
# Leave blank to disable the transcript feature entirely.
SPEECHMATICS_API_KEY=

# --- Auth -----------------------------------------------------------------
ADMIN_PASSWORD=clinic2026
RECEPTIONIST_TOKEN=demo-receptionist-token

# --- App ------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
CLINIC_NAME=Patiently Demo Clinic
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
